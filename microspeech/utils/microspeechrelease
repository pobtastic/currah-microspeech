set -e # Abort on errors

if [[ -z $MICROSPEECH_DISASSEMBLY_HOME ]]; then
  echo "Error: MICROSPEECH_DISASSEMBLY_HOME not defined."
  exit 1
fi
if [[ ! -d $MICROSPEECH_DISASSEMBLY_HOME ]]; then
  echo "Error: directory not found: $MICROSPEECH_DISASSEMBLY_HOME"
  exit 1
fi

if [[ -z $SKOOLKIT_HOME ]]; then
  echo "Error: SKOOLKIT_HOME not defined."
  exit 1
fi
if [[ ! -d $SKOOLKIT_HOME ]]; then
  echo "Error: directory not found: $SKOOLKIT_HOME"
  exit 1
fi

DHOME=$MICROSPEECH_DISASSEMBLY_HOME

. $DHOME/.dreleaserc

. $SKOOLKIT_HOME/tools/drelease-functions

parse_args $*
